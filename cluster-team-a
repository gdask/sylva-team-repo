apiVersion: workloadclusteroperator.sylva/v1alpha1
kind: SylvaWorkloadCluster
metadata:
  name: dev
spec:
  k8sVersion: "1.35"
  sylvaSourceVersion:
    branch: main
  infrastructure: openstack
  controlPlane:
    provider: rke2
    replicas: 3
  machineDeployments:
    md1:
      replicas: 1
  sylvaUnitsReleasePresets:
  - default
  - dev
  valuesFrom:
  - type: ExternalSecret
    name: sylva-secret
    valuesKey: secrets
  - type: ConfigMap
    name: test-cm
    targetPath: security
  - type: GitRepository
    name: common
    valuesPath: values
  clusterSettings:
    capo:
      ssh_key_name: my_key
      network_id: my_net
      os_image_selector:
        os: ubuntu
        hardened: true
      rootVolume:
        diskSize: 50
        volumeType: ceph_ssd
